<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <!-- Photographing a cheque / deposit slip. This is a real camera capture,
       so the permission genuinely applies and Play accepts it. -->
  <uses-permission android:name="android.permission.CAMERA"/>

  <!-- Broad media access is DELIBERATELY ABSENT.
       Picking an existing image goes through the Android Photo Picker
       (ActivityResultContracts.PickVisualMedia, used by expo-image-picker 17),
       which hands back only the chosen file and needs no permission at all.
       Google Play's Photo and Video Permissions policy reserves
       READ_MEDIA_IMAGES for apps whose core purpose is browsing or managing
       media; an app that merely attaches the occasional screenshot does not
       qualify, and a written justification is not accepted.

       expo-image-picker, expo-image and expo-file-system each declare
       READ_EXTERNAL_STORAGE / WRITE_EXTERNAL_STORAGE in their own manifests,
       so removing ours is not enough — these tools:node="remove" entries strip
       them from the MERGED manifest, which is what Play actually inspects.
       Verify with: aapt dump permissions <apk> -->
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
  <!-- Declared optional so the app still installs on camera-less devices. -->
  <uses-feature android:name="android.hardware.camera" android:required="false"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>

  <!-- Add android:usesCleartextTraffic="true" in the application tag below -->
  <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="true"
      android:theme="@style/AppTheme"
      android:supportsRtl="true"
      android:enableOnBackInvokedCallback="false"
      android:usesCleartextTraffic="true"> <!-- ADDED HERE -->

    <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/notification_icon_color"/>
    <meta-data android:name="expo.modules.notifications.default_notification_color" android:resource="@color/notification_icon_color"/>
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="omsapp"/>
        <data android:scheme="exp+omsapp"/>
      </intent-filter>
    </activity>
  </application>
</manifest>