{
  "expo": {
    "name": "OMSAPP",
    "slug": "OMSAPP",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "omsapp",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/logo.png",
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jivo.oms",
      "buildNumber": "7",
      "entitlements": {
        "aps-environment": "development"
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSCameraUsageDescription": "Take a photo of a cheque, UPI screenshot or deposit slip to attach to a payment.",
        "NSPhotoLibraryUsageDescription": "Attach a cheque image, UPI screenshot or deposit slip from your photos.",
        "NSPhotoLibraryAddUsageDescription": "Save photos you capture for a payment attachment."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 7,
      "permissions": [
        "INTERNET", "POST_NOTIFICATIONS", "CAMERA",
        "READ_MEDIA_IMAGES", "READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jivo.oms"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach a cheque image, UPI screenshot or deposit slip from your photos.",
          "cameraPermission": "Take a photo of a cheque, UPI screenshot or deposit slip to attach to a payment."
        }
      ],
      [
        "expo-notifications",
        {
          "mode": "development",
          "color": "#2563EB"
        }
      ]

    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "84e289e4-359a-4c6d-b656-0f52dc5bf4b8"
      }
    }
  }
}
